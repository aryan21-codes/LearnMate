# ==========================================
# LearnMate Live - Environment Configuration
# ==========================================
# Copy this file to .env (or backend/.env and frontend/.env)
# NEVER commit real secrets to version control.

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- OpenAI / LLM Provider (Backend Only) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Zoom Video SDK (Backend Only - NEVER expose Secret to frontend) ---
ZOOM_SDK_KEY=your_zoom_video_sdk_key_here
ZOOM_SDK_SECRET=your_zoom_video_sdk_secret_here

# --- Supabase (Optional for local MVP; falls back to local SQLite + disk storage if omitted) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=study-materials

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
